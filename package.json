{
  "name": "evalforge",
  "version": "1.0.0",
  "private": true,
  "description": "AI agent evaluation and reliability platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/worker.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run tests/regression",
    "test:ci": "npm test"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
