# Local development settings. Change placeholder secrets before exposing any service.
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
DATABASE_URL=postgres://evalforge:evalforge_dev_password@localhost:5432/evalforge
REDIS_URL=redis://localhost:6379

# Leave provider keys empty to use the deterministic Mock provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_1M_USD=
OPENAI_OUTPUT_COST_PER_1M_USD=
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_MS=13000
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_DEFAULT_TIMEOUT_COOLDOWN_MS=60000
GEMINI_DEFAULT_UNAVAILABLE_COOLDOWN_MS=30000
GEMINI_DEFAULT_QUOTA_COOLDOWN_MS=60000
GEMINI_INPUT_COST_PER_1M_USD=
GEMINI_OUTPUT_COST_PER_1M_USD=

# Optional model-specific pricing overrides, as a JSON object.
MODEL_COST_RATES_JSON=

EVAL_CONCURRENCY=3
EVAL_MAX_ATTEMPTS=3
EVAL_LOCK_DURATION_MS=120000

# For first local account setup, set registration true. Compose defaults this to false.
EVALFORGE_REGISTRATION_ENABLED=true
# Required to claim any legacy ownerless v1.0 data. Use a strong, private secret.
EVALFORGE_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
# Set true when running behind correctly configured HTTPS.
AUTH_COOKIE_SECURE=false
