# Local-only development defaults. Replace secrets before any shared deployment.
POSTGRES_PASSWORD=evalforge_dev_password
EVALFORGE_REGISTRATION_ENABLED=false
EVALFORGE_BOOTSTRAP_SECRET=
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
EVALFORGE_DOMAIN=localhost
EVAL_CONCURRENCY=3
OPENAI_MAX_CONCURRENCY=2
GEMINI_MAX_CONCURRENCY=2
EVAL_MAX_ATTEMPTS=3
EVAL_LOCK_DURATION_MS=120000
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional provider-wide fallback rates (USD per 1,000,000 tokens).
# Configure cached-input rates only when they match your provider/model billing tier.
OPENAI_INPUT_COST_PER_1M_USD=
OPENAI_OUTPUT_COST_PER_1M_USD=
OPENAI_CACHED_INPUT_COST_PER_1M_USD=
GEMINI_INPUT_COST_PER_1M_USD=
GEMINI_OUTPUT_COST_PER_1M_USD=
GEMINI_CACHED_INPUT_COST_PER_1M_USD=
# Optional exact model rates and historical pricing snapshot metadata:
# MODEL_COST_RATES_JSON={"gemini":{"gemini-3.8-flash":{"inputPer1MUsd":0.1,"outputPer1MUsd":0.4,"cachedInputPer1MUsd":0.02,"pricingSource":"provider pricing page","effectiveDate":"YYYY-MM-DD","tier":"standard","assumptions":["USD list price"]}}}
